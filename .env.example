# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solana
NEXT_PUBLIC_TOKEN_MINT=YourTokenMintAddress
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Admin login (single shared account). In development, if these are unset the
# panel accepts admin / admin. In production they are REQUIRED.
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=use-a-strong-password
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
